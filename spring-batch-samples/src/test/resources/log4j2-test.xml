<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{1.} - %msg%n" />
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="org.springframework.batch" level="debug" />

        <!-- SQL statements executed by JdbcTemplate (the batch metadata DAOs) -->
        <Logger name="org.springframework.jdbc.core.JdbcTemplate" level="debug" />
        <!-- Bound parameter values, e.g. the VERSION used in the optimistic-lock WHERE clause -->
        <Logger name="org.springframework.jdbc.core.StatementCreatorUtils" level="trace" />

        <!-- Transaction begin / commit / rollback boundaries.
             The configured manager is JdbcTransactionManager; the log category is the concrete class. -->
        <Logger name="org.springframework.jdbc.support.JdbcTransactionManager" level="debug" />
        <Logger name="org.springframework.jdbc.datasource.DataSourceTransactionManager" level="debug" />
        <Logger name="org.springframework.transaction" level="debug" />

        <Root level="error">
            <AppenderRef ref="Console" />
        </Root>
    </Loggers>
</Configuration>